# Server-side only. Never prefix these with NEXT_PUBLIC_ — that would inline
# them into the browser bundle and expose the API key to anyone with devtools.
HOOKFLOW_API_URL=http://localhost:8000
HOOKFLOW_API_KEY=hf_<prefix>_<secret>

# Optional: enables the API keys view, which uses the admin surface.
HOOKFLOW_ADMIN_TOKEN=
HOOKFLOW_TENANT_ID=
