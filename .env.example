# Copy to .env (do NOT commit .env)
DATABASE_URL=sqlite:///./hookflow.db
# Production example:
# DATABASE_URL=postgresql+psycopg://hookflow:hookflow@localhost:5432/hookflow
REDIS_URL=
# Production example:
# REDIS_URL=redis://localhost:6379/0

# Symmetric key protecting webhook secrets at rest.
# Accepts a Fernet key or any passphrase (SHA-256 stretched).
# Generate one with:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Leaving this empty uses a PUBLISHED development key. /ready will then report
# secret_encryption=development-key. Never do that in production.
SECRET_ENCRYPTION_KEY=
